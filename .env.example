# VOLLEY PERFORMANCE · TIME IFAL
# Variáveis de ambiente para produção (Vercel)

# Banco de dados: configure um projeto em https://supabase.com e execute o SQL
# de supabase-schema.sql no SQL Editor do projeto.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Segurança da sessão (JWT)
JWT_SECRET=uma_chave_secreta_muito_longa_e_aleatoria_aqui

# URL da aplicação
NEXT_PUBLIC_APP_URL=https://time-ifal.vercel.app
